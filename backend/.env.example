INFERENCE_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_NUM_GPU=0
# Optional CPU-only mode if the local GPU runner fails:
# OLLAMA_NUM_GPU=0
OLLAMA_TIMEOUT_SECONDS=120
FRONTEND_ORIGIN=http://localhost:3000
KNOWLEDGE_PATH=data/knowledge.md
JOB_STORAGE_PATH=storage/job_descriptions.sqlite3
REQUESTS_PER_MINUTE=20
JOB_MATCH_TIMEOUT_SECONDS=240
JOB_MATCH_CONTEXT_TOKENS=16384
JOB_MATCH_OUTPUT_TOKENS=4096

# Optional Runpod Serverless worker (see ../deploy/runpod/README.md).
# Set INFERENCE_PROVIDER=runpod and configure both credentials in backend/.env.
# RUNPOD_ENDPOINT_ID=your-endpoint-id
# RUNPOD_API_KEY=your-api-key
RUNPOD_TIMEOUT_SECONDS=300
# For Runpod set JOB_MATCH_TIMEOUT_SECONDS=600 to allow cold starts and both stages.
# OLLAMA_MODEL must match the model baked into the worker image.
# OLLAMA_NUM_GPU only affects local Ollama, so CPU-only local settings are safe to retain.
